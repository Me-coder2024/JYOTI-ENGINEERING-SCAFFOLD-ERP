# Copy to deploy/production.env. This directory ignores *.env files.
# Never use NEXT_PUBLIC_ for a database password, session secret or service-role key.
# Supabase Dashboard > Connect: use the pooler URL for runtime.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full
# Direct connection or session pooler on port 5432 for migration.
DIRECT_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_ORIGIN=https://YOUR_CLIENT_DOMAIN
# Set true only after disabling the Supabase Data API for this dedicated project.
SUPABASE_DATA_API_DISABLED=false
# Set on the host if Supabase provides a custom CA certificate:
# NODE_EXTRA_CA_CERTS=/run/secrets/supabase-ca.pem
